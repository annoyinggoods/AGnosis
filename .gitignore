# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
# The built Windows installer (a release artifact, rebuilt by
# packaging/windows/build-installer.ps1).
packaging/windows/dist/
selftest_out/

# The pre-rename release folder (ducks.exe, October 2026): dead after the
# rename to agnosis; the shipped artifact is the Inno installer in
# packaging/windows/dist/, built from target/release.
/built/

# Playwright MCP session debris (console logs, page snapshots).
.playwright-mcp/

# Python bytecode from the web tools (pngcheck, serve, force-backend).
__pycache__/
